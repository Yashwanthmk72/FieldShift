# Copy to .env and export before starting (the app reads real environment variables; it does not load .env itself).
FIELDSHIFT_ENV=development            # production enforces the checks below
FIELDSHIFT_SECRET_KEY=                # >= 32 random characters in production (python -c "import secrets;print(secrets.token_urlsafe(48))")
FIELDSHIFT_COOKIE_SECURE=false        # must be true in production (HTTPS)
FIELDSHIFT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000   # explicit allow-list, no wildcard in production
TRUSTED_PROXIES=                      # CIDRs of YOUR reverse proxies, e.g. 10.0.0.0/8. X-Forwarded-For is ignored otherwise
FIELDSHIFT_DB=backend/fieldshift.db
ASSISTANT_RATE_LIMIT=12
# Optional AI explanations. Both must be set; there is no default model name.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional error monitoring
SENTRY_DSN=
# Market prices (v0.7). Optional: free key from https://data.gov.in enables India mandi prices; without it India shows "no data".
DATA_GOV_IN_API_KEY=
# Exchange rates (ECB via Frankfurter). Default shown; override only if you self-host.
FX_API_URL=https://api.frankfurter.dev/v1/latest
